# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Without these, the contact form logs submissions to the terminal in dev (and shows an error in production).

# From resend.com → API Keys
RESEND_API_KEY=
# Where intake form submissions get delivered
CONTACT_TO_EMAIL=
# Optional. Until your domain is verified in Resend, leave this unset and
# onboarding@resend.dev is used (it can only deliver to your Resend account's email).
CONTACT_FROM_EMAIL=

# Terry, the blueprint agent. From console.anthropic.com → API Keys. Server-side only.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
TERRY_MODEL=
# Production kill switch: Terry's API returns 404 and the card is hidden unless this is
# "true". Always on in dev. Changing it in Vercel needs a redeploy.
TERRY_ENABLED=
# Terry runs per visitor per 24 hours. Defaults to 1. Raise it while friends test.
TERRY_DAILY_LIMIT=

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile). Required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for Terry's daily limit. Added automatically by Vercel → Storage → Upstash.
# Required in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
